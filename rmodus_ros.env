#-------------------------------------------------------------------------------
#  R-MODUS: sdilene promenne ROS 2 (Pi + vyvojarsky PC)
#  Soubor lezi v DEPLOY_PATH (napr. ~/rmodus_setup); nacita install.py do ~/.bashrc
#  a upraveny rmodus_entrypoint.sh v ~/ .
#-------------------------------------------------------------------------------

export ROS_DOMAIN_ID=0
export RMW_IMPLEMENTATION=rmw_fastrtps_cpp

