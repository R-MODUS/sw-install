#-------------------------------------------------------------------------------
#  R-MODUS — sdílené proměnné ROS 2 (Pi + vývojářský PC)
#  Soubor leží v DEPLOY_PATH (např. ~/rmodus_setup); načítá install.py do ~/.bashrc
#  a upravený rmodus_entrypoint.sh ve ~/ .
#-------------------------------------------------------------------------------

export ROS_DOMAIN_ID=0
export RMW_IMPLEMENTATION=rmw_fastrtps_cpp

