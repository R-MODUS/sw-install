#!/usr/bin/python3
"""CLI: list / activate R-MODUS profiles; print active or network path."""
from __future__ import annotations

import argparse
import sys
from pathlib import Path

_LIB = Path("/usr/local/lib/rmodus")
_HERE = Path(__file__).resolve().parent
for candidate in (_LIB, _HERE):
    if str(candidate) not in sys.path:
        sys.path.insert(0, str(candidate))

from rmodus_profiles import (  # noqa: E402
    ConfigPaths,
    list_profiles,
    read_active_name,
    resolve_active_profile,
    set_active,
)


def _paths_from_args(args: argparse.Namespace) -> ConfigPaths:
    root = getattr(args, "configs_root", None)
    if root:
        return ConfigPaths.from_root(Path(root))
    return ConfigPaths.from_root()


def main() -> int:
    parser = argparse.ArgumentParser(description="R-MODUS profile / network paths")
    parser.add_argument(
        "--configs-root",
        default="",
        help="override configs root (default: $RMODUS_CONFIGS or ~/rmodus/configs)",
    )
    sub = parser.add_subparsers(dest="cmd", required=True)

    sub.add_parser("list", help="vypsat jména profilů v profiles/")
    sub.add_parser("active", help="vypsat jméno aktivního profilu")

    path_p = sub.add_parser("path", help="vypsat cestu k souboru")
    path_g = path_p.add_mutually_exclusive_group(required=True)
    path_g.add_argument("--active", action="store_true", help="aktivní robot profil")
    path_g.add_argument("--network", action="store_true", help="network.yaml")
    path_g.add_argument("--active-file", action="store_true", help="soubor active")
    path_g.add_argument("--profiles-dir", action="store_true", help="adresář profiles/")

    act = sub.add_parser("activate", help="nastavit active na daný profil")
    act.add_argument("name", help="jméno profilu (bez .yaml)")

    args = parser.parse_args()
    if args.configs_root:
        args.configs_root = args.configs_root  # noqa: B018 — kept for clarity
    paths = ConfigPaths.from_root(Path(args.configs_root) if args.configs_root else None)

    try:
        if args.cmd == "list":
            for name in list_profiles(paths):
                mark = " *" if name == read_active_name(paths) else ""
                print(f"{name}{mark}")
            return 0
        if args.cmd == "active":
            name = read_active_name(paths)
            if not name:
                print(f"rmodus-config: žádný active v {paths.active_file}", file=sys.stderr)
                return 1
            print(name)
            return 0
        if args.cmd == "path":
            if args.active:
                print(resolve_active_profile(paths))
            elif args.network:
                print(paths.network_yaml)
            elif args.active_file:
                print(paths.active_file)
            else:
                print(paths.profiles_dir)
            return 0
        if args.cmd == "activate":
            path = set_active(paths, args.name)
            print(f"active -> {args.name} ({path})")
            return 0
    except (OSError, ValueError, FileNotFoundError) as exc:
        print(f"rmodus-config: {exc}", file=sys.stderr)
        return 1
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
