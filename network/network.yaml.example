# ============================================================
# R-MODUS: Konfigurace sítě (Wi-Fi Client & Access Point)
# ============================================================
# Tento blok 'network:' lze umístit buď do samostatného souboru
# ~/rmodus/configs/network.yaml, nebo přímo do hlavního
# konfiguráku ~/rmodus/configs/robot.yaml.
# ============================================================

network:
  # Režim připojení:
  #  - 'client': robot se připojuje k existující Wi-Fi síti
  #  - 'ap':     robot sám vysílá Wi-Fi Hotspot (Access Point)
  mode: client

  # Název a heslo cílové Wi-Fi sítě (pro režim client i ap)
  ssid: ""
  password: ""

  # --- Fallback Hotspot (Záchranný AP při nedostupnosti sítě) ---
  # Pokud je režim 'client', ale robot se nedokáže k zadané Wi-Fi připojit
  # (např. robot je v cizím prostředí / škole), automaticky vytvoří Hotspot.
  fallback: true                       # povolit automatický záchranný AP (true/false)
  fallback_timeout: 30                 # čas v sekundách pro pokus o připojení k Wi-Fi
  fallback_ssid: "R-MODUS-AP"          # název záchranné Wi-Fi sítě
  fallback_password: "rmodus123"       # heslo záchranné Wi-Fi (min. 8 znaků)

  # --- Pokročilá nastavení ---
  hidden: false                        # true, pokud cílová Wi-Fi nevysílá své SSID (skrytá síť)
  ap_address: "192.168.50.1/24"        # IP adresa a rozsah podsítě v režimu AP (web: http://192.168.50.1:8080)
  country: "CZ"                        # ISO kód země pro bezdrátové regulace (správné kanály a výkon)
  ros_domain_id: 0
