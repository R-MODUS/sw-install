#!/usr/bin/python3
"""Aplikuje WiFi rezim z bloku 'network:' v configs/network.yaml pres NetworkManager."""
from __future__ import annotations

import argparse
import os
import shutil
import subprocess
import sys
from pathlib import Path
from typing import Any

CLIENT_CON = "rmodus-wifi-client"
AP_CON = "rmodus-wifi-ap"
ETHERNET_MODES = ("ethernet", "none", "disabled")
DEFAULT_AP_ADDRESS = "192.168.50.1/24"
DEFAULT_COUNTRY = "CZ"
DEFAULT_FALLBACK_SSID = "R-MODUS-AP"
DEFAULT_FALLBACK_PASSWORD = "rmoduspassword"
DEFAULT_FALLBACK_TIMEOUT = 60


def _log(msg: str) -> None:
    print(f"rmodus-network: {msg}", flush=True)


def _run(cmd: list[str], *, check: bool = True, quiet: bool = False) -> subprocess.CompletedProcess[str]:
    shown = []
    skip_next = False
    for i, part in enumerate(cmd):
        if skip_next:
            skip_next = False
            shown.append("<redacted>")
            continue
        if part in ("wifi-sec.psk", "802-11-wireless-security.psk") and i + 1 < len(cmd):
            shown.append(part)
            skip_next = True
            continue
        shown.append(part)
    if not quiet:
        _log("+ " + " ".join(shown))
    return subprocess.run(cmd, check=check, text=True, capture_output=True)


def _nmcli(*args: str, check: bool = True, quiet: bool = False) -> subprocess.CompletedProcess[str]:
    return _run(["nmcli", *args], check=check, quiet=quiet)


def _as_bool(value: Any) -> bool:
    if isinstance(value, bool):
        return value
    return str(value or "").strip().lower() in ("1", "true", "yes", "on", "y")


def _clean_val(val: str) -> Any:
    val = val.strip()
    if (val.startswith('"') and val.endswith('"')) or (val.startswith("'") and val.endswith("'")):
        val = val[1:-1]
    low = val.lower()
    if low in ("true", "yes", "on"):
        return True
    if low in ("false", "no", "off"):
        return False
    if val.isdigit():
        return int(val)
    return val


def _strip_inline_comment(val: str) -> str:
    """Odřízne # komentář mimo uvozovky."""
    in_single = False
    in_double = False
    for i, ch in enumerate(val):
        if ch == "'" and not in_double:
            in_single = not in_single
        elif ch == '"' and not in_single:
            in_double = not in_double
        elif ch == "#" and not in_single and not in_double:
            return val[:i].rstrip()
    return val


def _extract_network_dict(doc: Any) -> dict[str, Any] | None:
    if isinstance(doc, dict) and isinstance(doc.get("network"), dict):
        return doc["network"]
    return None


def _indent_width(line: str) -> int:
    return len(line) - len(line.lstrip(" \t"))


def _parse_kv(stripped: str) -> tuple[str, Any]:
    k, v = stripped.split(":", 1)
    return k.strip(), _clean_val(_strip_inline_comment(v))


def _parse_network_fallback(text: str) -> dict[str, Any]:
    """Jednoduchý parser bloku network: včetně networks:, ap:, fallback_ap: (bez PyYAML)."""
    lines = text.splitlines()
    in_network = False
    network_indent: int | None = None
    net_dict: dict[str, Any] = {}
    in_networks = False
    networks_indent = 0
    networks: list[dict[str, Any]] = []
    current: dict[str, Any] | None = None
    nested_key: str | None = None
    nested_indent = 0
    nested_maps: dict[str, dict[str, Any]] = {}

    for line in lines:
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue

        if not in_network:
            if stripped == "network:" or stripped.startswith("network:"):
                in_network = True
                network_indent = None
            continue

        if not (line.startswith(" ") or line.startswith("\t")):
            break

        indent = _indent_width(line)
        if network_indent is None:
            network_indent = indent
        elif indent < network_indent:
            break

        if in_networks:
            if indent <= networks_indent:
                in_networks = False
                current = None
            else:
                if stripped.startswith("- "):
                    current = {}
                    networks.append(current)
                    rest = stripped[2:].strip()
                    if ":" in rest:
                        k, v = _parse_kv(rest)
                        current[k] = v
                    continue
                if current is not None and ":" in stripped:
                    k, v = _parse_kv(stripped)
                    current[k] = v
                continue

        if nested_key is not None:
            if indent <= nested_indent:
                nested_key = None
            else:
                if ":" in stripped:
                    k, v = _parse_kv(stripped)
                    nested_maps[nested_key][k] = v
                continue

        if stripped == "networks:" or stripped.startswith("networks:"):
            in_networks = True
            networks_indent = indent
            current = None
            after = _strip_inline_comment(stripped.split(":", 1)[1]).strip()
            if after and after != "[]":
                _log("networks: očekávám seznam položek (- ssid: ...), inline hodnotu ignoruji")
            continue

        key_name = stripped.split(":", 1)[0].strip()
        if key_name in ("ap", "fallback_ap") and (
            stripped == f"{key_name}:" or stripped.startswith(f"{key_name}:")
        ):
            nested_key = key_name
            nested_indent = indent
            nested_maps.setdefault(key_name, {})
            after = _strip_inline_comment(stripped.split(":", 1)[1]).strip()
            if after and after != "{}":
                _log(f"{key_name}: očekávám vnořený blok, inline hodnotu ignoruji")
            continue

        if ":" in stripped:
            k, v = _parse_kv(stripped)
            net_dict[k] = v

    if networks:
        net_dict["networks"] = networks
    for key, mapping in nested_maps.items():
        if mapping:
            net_dict[key] = mapping
    return net_dict


def parse_network_config(path: Path) -> dict[str, Any]:
    """Načte blok 'network:' z network.yaml (nebo legacy monolitického profilu)."""
    try:
        text = path.read_text(encoding="utf-8")
    except OSError as exc:
        _log(f"Nelze přečíst {path}: {exc}")
        return {}

    try:
        import yaml  # type: ignore

        loaded = yaml.safe_load(text)
        extracted = _extract_network_dict(loaded)
        if extracted is not None:
            return extracted
    except ImportError:
        pass
    except Exception as exc:
        _log(f"PyYAML parser selhal pro {path} ({exc}), zkouším vestavěný parser")

    return _parse_network_fallback(text)


def _parse_boot_fallback(text: str) -> dict[str, bool]:
    """Vestavěný parser top-level boot: {network, rmodus} (default true)."""
    out = {"network": True, "rmodus": True}
    in_boot = False
    boot_indent = 0
    for raw in text.splitlines():
        if not raw.strip() or raw.lstrip().startswith("#"):
            continue
        indent = len(raw) - len(raw.lstrip(" "))
        stripped = raw.strip()
        if stripped.startswith("boot:") or stripped == "boot:":
            in_boot = True
            boot_indent = indent
            continue
        if not in_boot:
            continue
        if indent <= boot_indent and ":" in stripped:
            in_boot = False
            continue
        if indent <= boot_indent:
            continue
        if ":" not in stripped:
            continue
        key, _, rest = stripped.partition(":")
        key = key.strip()
        if key not in out:
            continue
        val = rest.split("#", 1)[0].strip()
        if val:
            out[key] = _as_bool(val)
    return out


def parse_boot_config(path: Path) -> dict[str, bool]:
    """Načte blok 'boot:' — network/rmodus (chybí-li, obojí true)."""
    defaults = {"network": True, "rmodus": True}
    try:
        text = path.read_text(encoding="utf-8")
    except OSError as exc:
        _log(f"Nelze přečíst {path}: {exc}")
        return defaults

    try:
        import yaml  # type: ignore

        loaded = yaml.safe_load(text)
        if isinstance(loaded, dict):
            boot = loaded.get("boot")
            if isinstance(boot, dict):
                out = dict(defaults)
                if "network" in boot:
                    out["network"] = _as_bool(boot.get("network"))
                if "rmodus" in boot:
                    out["rmodus"] = _as_bool(boot.get("rmodus"))
                return out
            return defaults
    except ImportError:
        pass
    except Exception as exc:
        _log(f"PyYAML boot parser selhal pro {path} ({exc}), zkouším vestavěný parser")

    return _parse_boot_fallback(text)


def _normalize_wifi_entry(entry: Any, *, default_hidden: bool = False) -> dict[str, Any] | None:
    """Převede položku sítě na {ssid, password, hidden}. Neplatné přeskočí."""
    if not isinstance(entry, dict):
        return None
    ssid = str(entry.get("ssid") or "").strip()
    if not ssid:
        return None
    password = str(entry.get("password") or "")
    if "hidden" in entry:
        hidden = _as_bool(entry.get("hidden"))
    else:
        hidden = default_hidden
    return {"ssid": ssid, "password": password, "hidden": hidden}


def resolve_client_networks(cfg: dict[str, Any]) -> list[dict[str, Any]]:
    """
    Seznam Wi-Fi sítí pro mode: client.
    Pořadí v 'networks:' = priorita. hidden jen u položky (ne top-level).
    Legacy top-level ssid/password(/hidden) jen když networks chybí/je prázdný.
    """
    raw = cfg.get("networks")
    entries: list[dict[str, Any]] = []

    if isinstance(raw, list) and raw:
        for i, item in enumerate(raw):
            normalized = _normalize_wifi_entry(item, default_hidden=False)
            if normalized is None:
                _log(f"networks[{i}]: přeskočeno (chybí ssid nebo neplatný tvar)")
                continue
            entries.append(normalized)
        return entries

    legacy = _normalize_wifi_entry(
        {"ssid": cfg.get("ssid"), "password": cfg.get("password"), "hidden": cfg.get("hidden")},
        default_hidden=False,
    )
    return [legacy] if legacy else []


def resolve_ap_settings(cfg: dict[str, Any]) -> dict[str, Any]:
    """
    Parametry hotspotu: preferuje network.ap:{ssid,password,address,hidden}.
    Legacy: top-level ssid/password/ap_address.
    """
    ap = cfg.get("ap") if isinstance(cfg.get("ap"), dict) else {}
    ssid = str(ap.get("ssid") or cfg.get("ssid") or "").strip()
    if "password" in ap:
        password = str(ap.get("password") or "")
    else:
        password = str(cfg.get("password") or "")
    address = (
        str(ap.get("address") or ap.get("ap_address") or cfg.get("ap_address") or DEFAULT_AP_ADDRESS).strip()
        or DEFAULT_AP_ADDRESS
    )
    hidden = _as_bool(ap.get("hidden")) if "hidden" in ap else False
    return {"ssid": ssid, "password": password, "address": address, "hidden": hidden}


def resolve_fallback_ap_settings(cfg: dict[str, Any], *, default_address: str) -> dict[str, Any]:
    """
    Záchranný hotspot po neúspěchu client sítí.
    Preferuje network.fallback_ap:{enabled,timeout,ssid,password,address,hidden}.
    Legacy: fallback / fallback_timeout / fallback_ssid / fallback_password.
    """
    block = cfg.get("fallback_ap") if isinstance(cfg.get("fallback_ap"), dict) else {}

    if "enabled" in block:
        enabled = _as_bool(block.get("enabled"))
    elif "fallback" in cfg:
        enabled = _as_bool(cfg.get("fallback"))
    else:
        enabled = True

    raw_timeout = block.get("timeout", cfg.get("fallback_timeout", DEFAULT_FALLBACK_TIMEOUT))
    try:
        timeout = int(raw_timeout if raw_timeout is not None else DEFAULT_FALLBACK_TIMEOUT)
    except (ValueError, TypeError):
        timeout = DEFAULT_FALLBACK_TIMEOUT

    ssid = str(block.get("ssid") or cfg.get("fallback_ssid") or DEFAULT_FALLBACK_SSID).strip()
    if "password" in block:
        password = str(block.get("password") or "")
    else:
        password = str(cfg.get("fallback_password") or DEFAULT_FALLBACK_PASSWORD)

    address = (
        str(block.get("address") or block.get("ap_address") or default_address or DEFAULT_AP_ADDRESS).strip()
        or DEFAULT_AP_ADDRESS
    )
    hidden = _as_bool(block.get("hidden")) if "hidden" in block else False
    return {
        "enabled": enabled,
        "timeout": timeout,
        "ssid": ssid,
        "password": password,
        "address": address,
        "hidden": hidden,
    }


def resolve_config(cli_path: str | None = None) -> tuple[Path | None, dict[str, Any]]:
    """Vyhledá network.yaml a vrátí (cesta, slovník z bloku network:)."""
    if cli_path:
        p = Path(cli_path).expanduser()
        if p.is_file():
            return p, parse_network_config(p)
        _log(f"Soubor {p} neexistuje.")
        return p, {}

    env_p = os.environ.get("RMODUS_NETWORK_CONFIG") or os.environ.get("RMODUS_CONFIG")
    if env_p:
        p = Path(env_p).expanduser()
        if p.is_file():
            return p, parse_network_config(p)

    candidates: list[Path] = [
        Path.home() / "rmodus" / "configs" / "network.yaml",
        # legacy monolith profile (pre split)
        Path.home() / "rmodus" / "configs" / "current" / "current.yaml",
    ]

    for home_user in sorted(Path("/home").glob("*")):
        if home_user.is_dir():
            candidates.append(home_user / "rmodus" / "configs" / "network.yaml")
            candidates.append(home_user / "rmodus" / "configs" / "current" / "current.yaml")

    candidates.append(Path("/etc/rmodus/network.yaml"))
    candidates.append(Path("/etc/rmodus/current/current.yaml"))

    for cand in candidates:
        if cand.is_file():
            cfg = parse_network_config(cand)
            if cfg:
                return cand, cfg

    return None, {}


def resolve_robot_profile_for_boot() -> Path | None:
    """Aktivní robot profil (profiles/ + active) pro boot.rmodus check."""
    lib = Path("/usr/local/lib/rmodus")
    if lib.is_dir() and str(lib) not in sys.path:
        sys.path.insert(0, str(lib))
    try:
        from rmodus_profiles import ConfigPaths, resolve_active_profile

        return resolve_active_profile(ConfigPaths.from_root())
    except Exception:
        pass

    root = Path.home() / "rmodus" / "configs"
    active_file = root / "active"
    if not active_file.is_file():
        legacy = root / "current" / "current.yaml"
        return legacy if legacy.is_file() else None
    try:
        name = active_file.read_text(encoding="utf-8").strip().splitlines()[0].split("#", 1)[0].strip()
        if name.endswith(".yaml"):
            name = name[: -len(".yaml")]
        path = root / "profiles" / f"{name}.yaml"
        return path if path.is_file() else None
    except OSError:
        return None


def _ensure_nm() -> bool:
    if shutil.which("nmcli") is None:
        _log("CHYBA: nmcli není v PATH (balíček network-manager).")
        return False
    state = _nmcli("general", "status", check=False, quiet=True)
    if state.returncode != 0:
        _log("NetworkManager neběží, zkouším systemctl start...")
        _run(["systemctl", "start", "NetworkManager"], check=False)
        state = _nmcli("general", "status", check=False, quiet=True)
    if state.returncode != 0:
        _log("CHYBA: NetworkManager nelze spustit.")
        if state.stderr:
            print(state.stderr.strip(), file=sys.stderr)
        return False
    return True


def _wifi_iface(preferred: str) -> str | None:
    if preferred:
        return preferred
    listing = _nmcli("-t", "-f", "DEVICE,TYPE", "device", "status", check=False, quiet=True)
    if listing.returncode == 0:
        for line in listing.stdout.splitlines():
            if line.endswith(":wifi"):
                return line.split(":", 1)[0]
    return None


def _unblock_radio(country: str) -> None:
    _run(["rfkill", "unblock", "wifi"], check=False, quiet=True)
    _nmcli("radio", "wifi", "on", check=False, quiet=True)
    if country and shutil.which("iw"):
        _run(["iw", "reg", "set", country], check=False, quiet=True)


def _prepare_wifi_iface(iface: str) -> None:
    """Preda wlan NetworkManageru a uvolni radio (Imager/netplan klient jinak blokuje AP)."""
    _nmcli("device", "set", iface, "managed", "yes", check=False, quiet=True)
    _nmcli("device", "disconnect", iface, check=False, quiet=True)


def _wifi_rescan(iface: str, ssid: str) -> None:
    """Vynuti sken AP pred connection up (hotspot notebooku jinak casto neni v cache)."""
    _log(f"client: rescan Wi-Fi na {iface}...")
    listed = _nmcli(
        "-t",
        "-f",
        "SSID",
        "device",
        "wifi",
        "list",
        "--rescan",
        "yes",
        "ifname",
        iface,
        check=False,
    )
    if listed.returncode != 0:
        _nmcli("device", "wifi", "rescan", "ifname", iface, check=False, quiet=True)
        listed = _nmcli("-t", "-f", "SSID", "device", "wifi", "list", "ifname", iface, check=False)

    visible = {line.strip() for line in (listed.stdout or "").splitlines() if line.strip()}
    if ssid in visible:
        _log(f"client: síť '{ssid}' je ve skenu")
    else:
        _log(f"client: síť '{ssid}' ve skenu není (přesto zkouším připojení)")


def _delete_connection(name: str) -> None:
    _nmcli("connection", "delete", name, check=False, quiet=True)


def _modify_autoconnect(name: str, enabled: bool, priority: int | None = None) -> None:
    args = ["connection", "modify", name, "connection.autoconnect", "yes" if enabled else "no"]
    if enabled and priority is not None:
        args += ["connection.autoconnect-priority", str(priority)]
    _nmcli(*args, check=False, quiet=True)


def _set_psk(name: str, password: str) -> None:
    result = _nmcli(
        "connection",
        "modify",
        name,
        "wifi-sec.key-mgmt",
        "wpa-psk",
        "wifi-sec.psk",
        password,
        check=False,
    )
    if result.returncode != 0:
        _nmcli(
            "connection",
            "modify",
            name,
            "802-11-wireless-security.key-mgmt",
            "wpa-psk",
            "802-11-wireless-security.psk",
            password,
            check=False,
        )


def apply_client(iface: str, ssid: str, password: str, hidden: bool, timeout: int = 60) -> bool:
    """Nastaví a aktivuje Wi-Fi připojení v režimu Client. Vrací True při úspěchu."""
    _delete_connection(CLIENT_CON)
    _modify_autoconnect(AP_CON, False)
    args = [
        "connection",
        "add",
        "type",
        "wifi",
        "ifname",
        iface,
        "con-name",
        CLIENT_CON,
        "ssid",
        ssid,
        "ipv4.method",
        "auto",
        "ipv6.method",
        "auto",
        "connection.autoconnect",
        "yes",
        "connection.autoconnect-priority",
        "200",
    ]
    if hidden:
        args += ["802-11-wireless.hidden", "yes"]
    result = _nmcli(*args, check=False)
    if result.returncode != 0:
        raise RuntimeError((result.stderr or result.stdout or "nmcli connection add selhalo").strip())

    if password:
        _set_psk(CLIENT_CON, password)
    else:
        _nmcli("connection", "modify", CLIENT_CON, "wifi-sec.key-mgmt", "none", check=False)

    _nmcli("connection", "down", AP_CON, check=False, quiet=True)

    _prepare_wifi_iface(iface)
    _wifi_rescan(iface, ssid)
    _log(f"client: pokus o připojení k '{ssid}' na {iface} (timeout {timeout}s)...")
    up_res = _nmcli("-w", str(timeout), "connection", "up", CLIENT_CON, "ifname", iface, check=False)
    if up_res.returncode != 0:
        err = (up_res.stderr or up_res.stdout or "").strip()
        _log(f"client: připojení k '{ssid}' selhalo (kód {up_res.returncode}): {err}")
        return False

    _log(f"client: úspěšně připojeno k '{ssid}' na {iface}")
    return True


def apply_ap(iface: str, ssid: str, password: str, address: str, hidden: bool = False) -> None:
    """Spustí Wi-Fi Access Point (Hotspot). hidden=True = nevysílat SSID v beaconech."""
    if len(password) < 8:
        raise RuntimeError("AP režim vyžaduje heslo o délce alespoň 8 znaků (WPA2).")
    _delete_connection(AP_CON)
    _modify_autoconnect(CLIENT_CON, False)
    args = [
        "connection",
        "add",
        "type",
        "wifi",
        "ifname",
        iface,
        "con-name",
        AP_CON,
        "ssid",
        ssid,
        "802-11-wireless.mode",
        "ap",
        "802-11-wireless.band",
        "bg",
        "ipv4.method",
        "shared",
        "ipv4.addresses",
        address,
        "ipv6.method",
        "disabled",
        "connection.autoconnect",
        "yes",
        "connection.autoconnect-priority",
        "200",
    ]
    if hidden:
        args += ["802-11-wireless.hidden", "yes"]
    result = _nmcli(*args, check=False)
    if result.returncode != 0:
        raise RuntimeError((result.stderr or result.stdout or "nmcli connection add (AP) selhalo").strip())
    _set_psk(AP_CON, password)
    _nmcli("connection", "down", CLIENT_CON, check=False, quiet=True)
    _nmcli("connection", "modify", AP_CON, "connection.interface-name", iface, check=False, quiet=True)

    _prepare_wifi_iface(iface)
    up_res = _nmcli("-w", "30", "connection", "up", AP_CON, "ifname", iface, check=False)
    if up_res.returncode != 0:
        err = (up_res.stderr or up_res.stdout or "").strip()
        raise RuntimeError(f"nmcli connection up {AP_CON} selhalo: {err}")

    gw = address.split("/", 1)[0]
    visibility = "skrytý (hidden)" if hidden else "viditelný"
    _log(f"ap: hotspot '{ssid}' ({visibility}) spuštěn na {iface}, web: http://{gw}:8080")


def apply_ethernet() -> None:
    """Nespravuje Wi-Fi: vypne R-Modus profily a rádio, Ethernet nechá systému (DHCP)."""
    _nmcli("connection", "down", CLIENT_CON, check=False, quiet=True)
    _nmcli("connection", "down", AP_CON, check=False, quiet=True)
    _modify_autoconnect(CLIENT_CON, False)
    _modify_autoconnect(AP_CON, False)
    _delete_connection(CLIENT_CON)
    _delete_connection(AP_CON)
    _nmcli("radio", "wifi", "off", check=False, quiet=True)
    _run(["rfkill", "block", "wifi"], check=False, quiet=True)
    _log("ethernet: Wi-Fi klienta/AP nespouštím, rádio uspáno. Použij Ethernet (DHCP).")


def cmd_boot_check(key: str, config_arg: str | None) -> int:
    """Exit 0 = spustit, 10 = boot.<key> vypnuto. key: network|rmodus."""
    key = (key or "").strip().lower()
    if key not in ("network", "rmodus"):
        _log(f"CHYBA: boot-check očekává network|rmodus, dostal '{key}'")
        return 1

    if key == "network":
        cfg_path, _ = resolve_config(config_arg)
        if not cfg_path or not cfg_path.is_file():
            _log(
                f"boot-check: chybí network.yaml "
                f"({cfg_path or config_arg or '~/rmodus/configs/network.yaml'}) - beru boot.network=true"
            )
            return 0
        boot = parse_boot_config(cfg_path)
        enabled = boot.get("network", True)
        if enabled:
            return 0
        _log(f"boot.network=false v {cfg_path} - přeskočeno")
        return 10

    # rmodus → aktivní robot profil
    if config_arg:
        cfg_path = Path(config_arg).expanduser()
    else:
        cfg_path = resolve_robot_profile_for_boot()
    if not cfg_path or not cfg_path.is_file():
        _log(
            "boot-check: chybí aktivní robot profil "
            "(configs/active + profiles/) - beru boot.rmodus=true"
        )
        return 0
    boot = parse_boot_config(cfg_path)
    enabled = boot.get("rmodus", True)
    if enabled:
        return 0
    _log(f"boot.rmodus=false v {cfg_path} - přeskočeno")
    return 10


def cmd_apply(config_arg: str | None) -> int:
    cfg_path, cfg = resolve_config(config_arg)
    if not cfg or not cfg_path:
        _log(
            f"Blok 'network:' v network.yaml nebyl nalezen "
            f"(hledáno: {cfg_path or config_arg or '~/rmodus/configs/network.yaml'}) - síť neměním."
        )
        return 0

    boot = parse_boot_config(cfg_path)
    if not boot.get("network", True):
        _log(f"boot.network=false v {cfg_path} - síť neměním")
        return 0

    _log(f"Používám konfiguraci: {cfg_path}")
    mode = str(cfg.get("mode") or "client").strip().lower()
    iface_pref = str(cfg.get("iface") or "").strip()
    country = str(cfg.get("country") or DEFAULT_COUNTRY).strip() or DEFAULT_COUNTRY
    ap_cfg = resolve_ap_settings(cfg)
    fb_cfg = resolve_fallback_ap_settings(cfg, default_address=ap_cfg["address"])

    if mode not in ("client", "ap") and mode not in ETHERNET_MODES:
        _log(f"CHYBA: Neznámý mode '{mode}' (očekávám client|ap|ethernet)")
        return 1

    if mode in ETHERNET_MODES:
        if _ensure_nm():
            apply_ethernet()
        else:
            _run(["rfkill", "block", "wifi"], check=False, quiet=True)
            _log("ethernet: NetworkManager není, Wi-Fi jen rfkill. Ethernet nechávám systému.")
        return 0

    if not _ensure_nm():
        return 1

    iface = _wifi_iface(iface_pref)
    if not iface:
        _log("Žádné Wi-Fi zařízení (nmcli) - síť neměním.")
        return 0

    _unblock_radio(country)

    try:
        if mode == "client":
            candidates = resolve_client_networks(cfg)
            connected = False
            if not candidates:
                _log("Žádná klientská síť (networks: / ssid) v konfiguraci.")
            else:
                _log(f"client: {len(candidates)} síť(í) podle priority")
                for i, entry in enumerate(candidates, start=1):
                    _log(f"client: [{i}/{len(candidates)}] zkouším '{entry['ssid']}'...")
                    connected = apply_client(
                        iface,
                        entry["ssid"],
                        entry["password"],
                        entry["hidden"],
                        timeout=fb_cfg["timeout"],
                    )
                    if connected:
                        break

            if not connected:
                if fb_cfg["enabled"]:
                    _log(f"Aktivuji záchranný Fallback Hotspot (AP) '{fb_cfg['ssid']}'...")
                    apply_ap(
                        iface,
                        fb_cfg["ssid"],
                        fb_cfg["password"],
                        fb_cfg["address"],
                        hidden=bool(fb_cfg["hidden"]),
                    )
                    return 0
                _log("Fallback je zakázán (fallback_ap.enabled=false), síť zůstává nepřipojena.")
                return 1 if candidates else 0
            return 0

        # Režim AP — jedna síť (networks: se nepoužívá)
        if isinstance(cfg.get("networks"), list) and cfg.get("networks"):
            _log("mode: ap — seznam networks: ignoruji (hotspot bere ap: / ssid)")
        ap_ssid = ap_cfg["ssid"] if ap_cfg["ssid"] else fb_cfg["ssid"]
        ap_pass = ap_cfg["password"] if ap_cfg["password"] else fb_cfg["password"]
        apply_ap(iface, ap_ssid, ap_pass, ap_cfg["address"], hidden=bool(ap_cfg["hidden"]))
        return 0

    except (RuntimeError, subprocess.CalledProcessError) as exc:
        _log(f"CHYBA: {exc}")
        return 1


def cmd_status() -> int:
    if not _ensure_nm():
        return 1
    out = _nmcli("-t", "-f", "DEVICE,TYPE,STATE,CONNECTION", "device", "status", check=False)
    sys.stdout.write(out.stdout)
    return 0 if out.returncode == 0 else 1


def main() -> int:
    os.environ.setdefault("LC_ALL", "C")
    parser = argparse.ArgumentParser(description="R-Modus síť: Wi-Fi client/AP nebo Ethernet")
    sub = parser.add_subparsers(dest="cmd", required=True)
    apply_p = sub.add_parser("apply", help="nastavit síť podle network.yaml (blok network:)")
    apply_p.add_argument(
        "config",
        nargs="?",
        default=os.environ.get("RMODUS_NETWORK_CONFIG") or os.environ.get("RMODUS_CONFIG", ""),
        help="cesta k network.yaml",
    )
    boot_p = sub.add_parser(
        "boot-check",
        help="exit 0 pokud boot.<key> povoleno, 10 pokud vypnuto (network|rmodus)",
    )
    boot_p.add_argument("key", choices=("network", "rmodus"))
    boot_p.add_argument(
        "config",
        nargs="?",
        default="",
        help="network.yaml (pro network) nebo robot profil (pro rmodus); prázdné = auto",
    )
    sub.add_parser("status", help="stav NM zařízení")
    args = parser.parse_args()
    if args.cmd == "status":
        return cmd_status()
    if args.cmd == "boot-check":
        return cmd_boot_check(args.key, args.config if args.config else None)
    return cmd_apply(args.config if args.config else None)


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        raise SystemExit(130)
